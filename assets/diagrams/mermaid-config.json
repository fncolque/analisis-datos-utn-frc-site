{
  "theme": "base",
  "securityLevel": "strict",
  "fontFamily": "Telegraf, Bahnschrift, Aptos, sans-serif",
  "themeVariables": {
    "background": "#F2F2F2",
    "primaryColor": "#DCE6F1",
    "primaryTextColor": "#151616",
    "primaryBorderColor": "#1F497D",
    "secondaryColor": "#F2F2F2",
    "secondaryTextColor": "#151616",
    "secondaryBorderColor": "#778899",
    "tertiaryColor": "#FFFF33",
    "tertiaryTextColor": "#151616",
    "tertiaryBorderColor": "#1F497D",
    "lineColor": "#1F497D",
    "textColor": "#151616",
    "mainBkg": "#DCE6F1",
    "nodeBorder": "#1F497D",
    "clusterBkg": "#F2F2F2",
    "clusterBorder": "#778899",
    "edgeLabelBackground": "#F2F2F2",
    "actorBkg": "#DCE6F1",
    "actorBorder": "#1F497D",
    "actorTextColor": "#151616",
    "signalColor": "#1F497D",
    "signalTextColor": "#151616",
    "labelBoxBkgColor": "#F2F2F2",
    "labelBoxBorderColor": "#1F497D"
  },
  "flowchart": {
    "curve": "linear",
    "htmlLabels": true,
    "padding": 18,
    "nodeSpacing": 38,
    "rankSpacing": 48
  },
  "er": {
    "layoutDirection": "LR",
    "minEntityWidth": 120,
    "minEntityHeight": 80
  }
}
